# Telegram Bot Configuration
# Get your token by talking to @BotFather on Telegram (https://t.me/botfather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_sample

# Optional Admin Telegram Chat ID (your personal numeric user ID from @userinfobot)
# Gives you broadcast privileges, message scanning, and channel management
ADMIN_CHAT_ID=

# ==============================================================
# TELEGRAM CHANNEL CONFIGURATION
# ==============================================================
# Your Telegram Channel username (e.g. @my_channel_username) or Channel ID (e.g. -1001234567890)
# Make sure your bot is added to your channel as an Administrator (so it can read/index posts)!
CHANNEL_ID=@your_channel_username

# (Optional) If you want to sample random message IDs from a specific ID range:
CHANNEL_MIN_MSG_ID=1
CHANNEL_MAX_MSG_ID=100

# ==============================================================
# BOT BEHAVIOR
# ==============================================================
# Auto-send a random video immediately when a user types /start (true / false)
AUTO_SEND_ON_START=true

# API Server Port
PORT=3001

# ==============================================================
# TELEGRAM STARS SUBSCRIPTION CONFIGURATION
# ==============================================================
# Price in Telegram Stars (XTR) for a 1-day subscription
STARS_1DAY_PRICE=50

# Number of free trial videos before subscription is required (0 = paid only)
FREE_VIDEOS_LIMIT=1

# ==============================================================
# FIREBASE FIRESTORE CLOUD DATABASE (PERSISTENCE FOR RENDER)
# ==============================================================
# Option A: Local serviceAccountKey.json file path
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Full JSON String in one line (Recommended for Render Dashboard environment variables)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
