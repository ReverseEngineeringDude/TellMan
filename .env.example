# TellMan Telegram Environment Configuration Template
VITE_TELEGRAM_API_ID=your_api_id_here
VITE_TELEGRAM_API_HASH=your_api_hash_here
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_PHONE=+1234567890
VITE_TELEGRAM_USERNAME=@your_username
VITE_TELEGRAM_ACCOUNT_NAME="Your Telegram Name"

# Pre-configured profiles loaded from .env into Dashboard:
VITE_TELEGRAM_PROFILES='[
  {
    "id": "tg-1",
    "name": "Main Account",
    "username": "@username",
    "phone": "+1234567890",
